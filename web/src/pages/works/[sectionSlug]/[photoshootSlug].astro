---
import { getHomepageSeo } from "../../../api/homepage";
import {
	getPhotoshootPageBySlug,
	getPhotoshootSlugs,
} from "../../../api/photoshoots";
import PhotoshootGalleryPage from "../../../components/PhotoshootGalleryPage";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { optimizeImages } from "../../../lib/images";

export const prerender = import.meta.env.PROD;

export async function getStaticPaths() {
	const pages = await getPhotoshootSlugs();

	return pages.map(({ sectionSlug, photoshootSlug }) => ({
		params: {
			sectionSlug,
			photoshootSlug,
		},
	}));
}

const { sectionSlug, photoshootSlug } = Astro.params;

if (!sectionSlug || !photoshootSlug) {
	return new Response(null, { status: 404, statusText: "Not Found" });
}

const seo = await getHomepageSeo();
const page = await getPhotoshootPageBySlug(sectionSlug, photoshootSlug);

if (!page) {
	return new Response(null, { status: 404, statusText: "Not Found" });
}

const { section, photoshoot } = page;
const optimizedPhotoshoot = {
	title: photoshoot.title,
	description: photoshoot.description,
	images: await optimizeImages(photoshoot.images, {
		widths: [480, 720, 960, 1200],
		sizes: "(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 33vw",
	}),
};
---

<BaseLayout
	title={`${seo.title} | ${photoshoot.title}`}
	description={photoshoot.description || section.description}
	background="#faf8f5"
>
	<main>
		<PhotoshootGalleryPage
			client:load
			sectionSlug={section.slug}
			sectionTitle={section.title}
			photoshoot={optimizedPhotoshoot}
		/>
	</main>
</BaseLayout>
