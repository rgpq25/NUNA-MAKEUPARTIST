---
import PhotoshootGalleryPage from "../../../components/PhotoshootGalleryPage";
import { getPhotoshootPages } from "../../../api/photoshoots";
import { optimizeImage } from "../../../lib/images";
import type { Photoshoot, SectionPageContent } from "../../../types/content";
import type { OptimizedImageAsset } from "../../../types/images";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
	const pages = await getPhotoshootPages();

	return pages.map(
		({
			section,
			photoshoot,
		}: {
			section: SectionPageContent;
			photoshoot: Photoshoot;
		}) => ({
			params: {
				sectionSlug: section.slug,
				photoshootSlug: photoshoot.slug,
			},
			props: {
				section,
				photoshoot,
			},
		}),
	);
}

const { section, photoshoot } = Astro.props as {
	section: SectionPageContent;
	photoshoot: Photoshoot;
};
const optimizedPhotoshoot = {
	title: photoshoot.title,
	description: photoshoot.description,
	images: await Promise.all(
		photoshoot.images.map(
			async (image): Promise<OptimizedImageAsset> => ({
				...(await optimizeImage(image.src, {
					widths: [480, 720, 960, 1200],
					sizes: "(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 33vw",
				})),
				title: image.title,
				description: image.description,
			}),
		),
	),
};
---

<BaseLayout
	title={`NUNA Makeup Artist | ${photoshoot.title}`}
	description={photoshoot.description || section.description}
	background="#faf8f5"
>
	<main>
		<PhotoshootGalleryPage
			client:load
			sectionSlug={section.slug}
			sectionTitle={section.title}
			photoshoot={optimizedPhotoshoot}
		/>
	</main>
</BaseLayout>
