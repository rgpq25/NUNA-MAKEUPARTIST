---
import type { PreviewSection } from "../../data/home";
import { getSectionPreviews } from "../../lib/homepage";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const sections = await getSectionPreviews();

  return sections.map((section) => ({
    params: { slug: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props as { section: PreviewSection };
---

<BaseLayout
  title={`NUNA Makeup Artist | ${section.title}`}
  description={section.description}
>
  <main class="min-h-screen bg-[#faf8f5] px-8 py-24 md:px-16 md:py-32">
    <div class="container mx-auto max-w-6xl">
      <a
        href={`/#${section.slug}`}
        class="mb-10 inline-flex border border-[#2a2a2a]/15 px-5 py-3 font-['Montserrat'] text-xs tracking-[0.2em] text-[#2a2a2a]/70 uppercase transition-colors duration-300 hover:border-[#c9a96e]/40 hover:text-[#c9a96e]"
      >
        Volver al inicio
      </a>

      <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-[1.1fr_0.9fr] md:gap-16">
        <div>
          <p class="mb-4 font-['Montserrat'] text-xs tracking-[0.3em] text-[#2a2a2a]/45 uppercase">
            Works
          </p>
          <h1 class="mb-6 font-['Cormorant_Garamond'] text-6xl leading-none text-[#2a2a2a] md:text-8xl">
            {section.title}
          </h1>
          <p class="max-w-xl font-['Montserrat'] text-base leading-relaxed text-[#2a2a2a]/70 md:text-lg">
            {section.description}
          </p>
        </div>

        <div class="aspect-[3/4] overflow-hidden bg-[#f3eee7]">
          <img
            src={section.images[0]}
            alt={section.title}
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
        {
          section.images.map((image, index) => (
            <div class="aspect-[3/4] overflow-hidden bg-[#f3eee7]">
              <img
                src={image}
                alt={`${section.title} ${index + 1}`}
                class="h-full w-full object-cover"
              />
            </div>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
