---
import SectionPhotoshootCarousel from "../../components/SectionPhotoshootCarousel";
import { getSectionPages } from "../../api/sections";
import type { SectionPageContent } from "../../types/content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const sections = await getSectionPages();

  return sections.map((section: SectionPageContent) => ({
    params: { sectionSlug: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props as { section: SectionPageContent };
---

<BaseLayout
  title={`NUNA Makeup Artist | ${section.title}`}
  description={section.description}
>
  <main>
    <SectionPhotoshootCarousel
      client:load
      sectionSlug={section.slug}
      sectionTitle={section.title}
      sectionDescription={section.description}
      photoshoots={section.photoshoots}
    />
  </main>
</BaseLayout>
