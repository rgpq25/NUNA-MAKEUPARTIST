---
import BiographySection from "../components/BiographySection";
import ContactSection from "../components/ContactSection";
import HeroSection from "../components/HeroSection";
import Navigation from "../components/Navigation";
import PreviewCarousel from "../components/PreviewCarousel";
import { getHomepageContent } from "../api/homepage";
import { optimizeImage, optimizeImages } from "../lib/images";
import BaseLayout from "../layouts/BaseLayout.astro";

const homepage = await getHomepageContent();
const [heroImage, biographyImage, sections] = await Promise.all([
  optimizeImage(homepage.hero.image, {
    widths: [640, 960, 1280, 1600],
    sizes: "(max-width: 767px) 100vw, (max-width: 1279px) 52vw, 46vw",
  }),
  optimizeImage(homepage.biography.image, {
    widths: [480, 720, 960, 1280],
    sizes: "(max-width: 1023px) 100vw, 50vw",
  }),
  Promise.all(
    homepage.sections.map(async (section) => ({
      ...section,
      images: await optimizeImages(section.images, {
        widths: [480, 720, 960],
        sizes: "(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 28vw",
      }),
    })),
  ),
]);
---

<BaseLayout
  title={homepage.seo.title}
  description={homepage.seo.description}
>
  <div id="top" class="w-full overflow-x-hidden">
    <Navigation
      client:load
      brandTitle={homepage.branding.title}
      brandSubtitle={homepage.branding.subtitle}
      links={homepage.navigation}
    />

    <main>
      <HeroSection
        client:load
        brandTitle={homepage.branding.title}
        brandSubtitle={homepage.branding.subtitle}
        headline={homepage.hero.headline}
        description={homepage.hero.description}
        location={homepage.hero.location}
        image={heroImage}
        imageAlt={homepage.hero.imageAlt}
      />

      {
        sections.map((section, index) => (
          <div
            id={section.slug}
            class={`${index % 2 === 0 ? "bg-[#f5f2ed]" : "bg-[#faf8f5]"}`}
            style="scroll-margin-top: calc(var(--site-nav-height, 88px) + 1.5rem);"
          >
            <PreviewCarousel client:load {...section} reversed={index % 2 === 1} />
          </div>
        ))
      }

      <BiographySection client:load {...homepage.biography} image={biographyImage} />
      <ContactSection
        client:load
        serviceOptions={sections.map((section) => section.title)}
      />
    </main>
  </div>
</BaseLayout>
